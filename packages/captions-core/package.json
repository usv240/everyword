{
  "name": "@everyword/captions-core",
  "version": "0.1.0",
  "description": "The EveryWord caption format and engine: word-timed caption documents, a normalizer for Amazon Transcribe output (segmentation, clause-aware line breaks, gap tiling), and the pure word-index math that drives karaoke highlighting.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "test": "vitest run",
    "build": "tsc -b",
    "prepublishOnly": "tsc -b"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./src/*": "./src/*"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "captions",
    "subtitles",
    "webvtt",
    "karaoke",
    "word-timing",
    "amazon-transcribe",
    "same-language-subtitling",
    "literacy"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usv240/everyword.git",
    "directory": "packages/captions-core"
  },
  "homepage": "https://github.com/usv240/everyword/tree/main/packages/captions-core",
  "bugs": {
    "url": "https://github.com/usv240/everyword/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
